# Copie para src/ai/.env e preencha com valores reais.
# Nunca commitar o .env (já está no .gitignore da raiz).

# Groq
GROQ_API_KEY=
GROQ_MODEL=llama-3.3-70b-versatile

# PostgreSQL (mesmo banco do ETL)
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DB_NAME=VoteBem
POSTGRES_USER=
POSTGRES_PASSWORD=

# Embeddings
EMBED_MODEL=paraphrase-multilingual-MiniLM-L12-v2
EMBED_DIM=384

# Servidor FastAPI
AI_HOST=0.0.0.0
AI_PORT=8001
